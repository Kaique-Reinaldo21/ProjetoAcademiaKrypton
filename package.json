{
  "name": "academia-kripton",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend da Academia Kripton com autenticação JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node prisma/seed.js",
    "check:env": "node scripts/check-env.js",
    "check:db": "node scripts/check-db.js",
    "prisma:status": "prisma migrate status",
    "check:syntax": "node --check server.js && node --check scripts/check-env.js && node --check scripts/check-db.js && node --check scripts/local-db-guard.js && node --check scripts/setup-local.js && node --check scripts/seed-local-unidades.js",
    "test": "node --import ./tests/setup-isolamento.js --test",
    "setup:local": "node scripts/setup-local.js",
    "demo:unidades:local": "node scripts/seed-local-unidades.js",
    "test:integration": "node --test integration/*.mysql.mjs",
    "test:integration:migrate": "node integration/migrate.mjs",
    "conta:admin-inicial": "node scripts/criar-admin-inicial.js"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.6.1",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/passport-google-oauth20": "^2.0.17",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
