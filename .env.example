# ==========================================
# SERVIDOR
# ==========================================

PORT=3000
NODE_ENV=development


# ==========================================
# MYSQL
# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=krypton_app
DB_PASSWORD=
DB_NAME=academia_kripton


# ==========================================
# PRISMA
# ==========================================

DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/academia_kripton"


# ==========================================
# JWT
# ==========================================

JWT_SECRET=
JWT_EXPIRES_IN=7d


# ==========================================
# SESSÃO / PASSPORT
# ==========================================

SESSION_SECRET=


# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# ==========================================
# MERCADO PAGO - CHECKOUT DE ASSINATURAS
# ==========================================
# Credenciais do ambiente de testes; NUNCA publicar valores reais.
mercado_pago_access_token=
# Use URL publica HTTPS real (ex.: ngrok). localhost e HTTP sao rejeitados pelo Mercado Pago.
MP_BACK_URL=https://SEU_DOMINIO_PUBLICO_HTTPS/checkout/success
# Segredo das notificacoes Webhook gerado no painel do Mercado Pago.
MP_WEBHOOK_SECRET=
