        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/usuario/unidades": {
      "get": {
        "tags": [
          "Aluno"
        ],
        "summary": "Consultar unidades",
        "description": "Consulta autenticada de unidades.",
        "responses": {
          "200": {
