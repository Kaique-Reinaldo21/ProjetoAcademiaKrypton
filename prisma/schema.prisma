generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model agendamentos {
  id         Int               @id @default(autoincrement()) @db.UnsignedInt
  usuario_id Int               @db.UnsignedInt
  tipo       agendamentos_tipo
  data_hora  DateTime          @db.DateTime(0)
  observacao String?           @db.Text
  created_at DateTime?         @default(now()) @db.DateTime(0)
  usuarios   usuarios          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agendamentos_ibfk_1")

  @@index([usuario_id], map: "idx_usuario_ag")
}

model historico_logins {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  usuario_id Int       @db.UnsignedInt
  data_login DateTime? @default(now()) @db.DateTime(0)
  ip         String?   @db.VarChar(45)
  user_agent String?   @db.VarChar(255)
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "historico_logins_ibfk_1")

  @@index([usuario_id], map: "usuario_id")
}

model planos {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  usuario_id Int         @db.UnsignedInt
  tipo       planos_tipo
  ativo      Boolean     @default(true)
  unidade_id Int?        @db.UnsignedInt
  inicio     DateTime    @default(dbgenerated("(curdate())")) @db.Date
  vencimento DateTime?   @db.Date
  updated_at DateTime?   @default(now()) @db.DateTime(0)
  usuarios   usuarios    @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "planos_ibfk_1")
  transacoes_pagamento transacoes_pagamento[]
  mp_plan_id String?     @db.VarChar(100)
  mp_preapproval_id String? @unique @db.VarChar(100)

  @@index([usuario_id], map: "idx_usuario")
}

model unidades {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  nome      String  @db.VarChar(120)
  endereco  String  @db.VarChar(255)
  cidade    String  @db.VarChar(80)
  telefone  String? @db.VarChar(20)
  horario   String? @db.VarChar(80)

  latitude  Float?
  longitude Float?
}

model usuarios {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  nome             String             @db.VarChar(120)
  email            String             @unique(map: "email") @db.VarChar(180)
  senha_hash       String?            @db.VarChar(255)
  google_sub       String?            @unique @db.VarChar(255)
  versao_sessao    Int                @default(0) @db.UnsignedInt
  senha_redefinicao_obrigatoria Boolean @default(false)
  data_nascimento  DateTime?          @db.Date
  role             usuarios_role      @default(aluno)
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  agendamentos     agendamentos[]
  historico_logins historico_logins[]
  planos           planos[]
  transacoes_pagamento transacoes_pagamento[]
  checkout_tentativas checkout_tentativas[]
  recuperacao_senha recuperacoes_senha?
  foto_perfil fotos_perfil?
}

model fotos_perfil {
  usuario_id Int      @id @db.UnsignedInt
  imagem     Bytes    @db.MediumBlob
  usuario    usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model estados_oauth_google {
  state_hash     String   @id @db.Char(64)
  navegador_hash String  @db.Char(64)
  expira_em      DateTime @db.DateTime(3)
  usuario_id     Int?     @db.UnsignedInt
  versao_sessao  Int?     @db.UnsignedInt

  @@index([expira_em])
}

model recuperacoes_senha {
  usuario_id Int      @id @db.UnsignedInt
  token_hash String   @unique @db.Char(64)
  expira_em  DateTime @db.DateTime(3)
  usuario    usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model limites_conta {
  chave     String   @id @db.Char(64)
  contador  Int      @db.UnsignedInt
  expira_em DateTime @db.DateTime(3)

  @@index([expira_em])
}

model auditoria_contas {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  autor_id   Int?     @db.UnsignedInt
  usuario_id Int      @db.UnsignedInt
  evento     String   @db.VarChar(40)
  criado_em  DateTime @default(now()) @db.DateTime(3)

  @@index([usuario_id, criado_em])
}

enum agendamentos_tipo {
  nutricionista
  personal
}

enum planos_tipo {
  basico
  pro
  elite
}

enum usuarios_role {
  aluno
  admin
  personal
  nutricionista
}

enum checkout_metodo {
  mercadopago
  qr_krypton
  mercadopago_simulado
}

enum checkout_resposta_mp_demo {
  pendente
  aprovada
  recusada
}

model checkout_tentativas {
  id                String   @id @db.VarChar(36)
  usuario_id        Int      @db.UnsignedInt
  tipo              planos_tipo
  unidade_id        Int?     @db.UnsignedInt
  mp_preapproval_id String?  @unique @db.VarChar(100)
  metodo            checkout_metodo @default(mercadopago)
  resposta_mp_demo  checkout_resposta_mp_demo?
  qr_token_hash     String?  @db.Char(64)
  qr_expira_em      DateTime? @db.DateTime(3)
  status            String   @default("pendente") @db.VarChar(20)
  created_at        DateTime @default(now()) @db.DateTime(0)
  updated_at        DateTime @updatedAt @db.DateTime(0)
  usuarios          usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  transacoes_pagamento transacoes_pagamento[]

  @@index([usuario_id, status])
}

model transacoes_pagamento {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  mp_payment_id     String   @unique @db.VarChar(100)
  mp_preapproval_id String?  @db.VarChar(100)
  usuario_id        Int      @db.UnsignedInt
  tentativa_id      String   @db.VarChar(36)
  plano_id          Int?     @db.UnsignedInt
  valor_centavos    Int      @db.UnsignedInt
  moeda             String   @db.Char(3)
  status            String   @db.VarChar(32)
  origem            String   @default("mercadopago") @db.VarChar(16)
  data_fatura       DateTime? @db.DateTime(3)
  criado_em         DateTime @default(now()) @db.DateTime(3)
  atualizado_em     DateTime @default(now()) @db.DateTime(3)
  usuarios          usuarios @relation(fields: [usuario_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tentativa         checkout_tentativas @relation(fields: [tentativa_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plano             planos? @relation(fields: [plano_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([mp_preapproval_id])
  @@index([usuario_id])
  @@index([tentativa_id])
  @@index([plano_id])
}
